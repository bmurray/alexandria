/// Alexandria on the local k3s cluster (context `default`, node `debian`).
///
///     make manifests                   # -> deploy/out/k3s/manifests/alexandria.yaml
///     IMAGE_TAG=0.1.0 make manifests   # what release.yml does for tag v0.1.0
///
/// Secrets are named by key only; deploy/secrets.sh renders the Secret from
/// ~/.config/secrets/valsoft.json and ~/.openai/auth.json and it is applied
/// by hand (never by Flux).
amends "@schema/deploy/k8s/Manifests.pkl"

import "@schema/deploy/k8s/App.pkl"

app {
  image = "ghcr.io/bmurray/alexandria:\(read?("env:IMAGE_TAG") ?? "main")"
  // The k3s node pulls ghcr with its own registries.yaml credentials.
  imagePullSecret = null

  // `new Listing`: an untyped `new {}` would amend the default and append.
  hostnames = new Listing { "alexandria.bmurray.ca" }
  gatewayClassName = "traefik"
  tls = true // cert-manager + letsencrypt-prod exist on the k3s cluster

  admins { "brian@bmurray.ca" }

  // Client ID and secret both come from the Secret (deploy/secrets.sh reads
  // ~/.config/secrets/valsoft.json). devops/README.md has the redirect URI.
  google = new App.GoogleOidc {}

  ai {
    enabled = true
    lunaSpendLimitUsd = 5.0
    dailySpendLimitUsd = 5.0
  }

  storage {
    path = "/data/docker_volumes/alexandria" // /data is backed up
    node = "debian"
  }

  otelEnabled = true
  otelEndpoint = "monitoring.monitoring.svc.cluster.local:4317"
}
