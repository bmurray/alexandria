/// End-to-end tests: embedded web build (no Vite proxy), a throwaway database,
/// the Dev sign-in, no AI, no telemetry. CI needs nothing but the binary.
amends "dev.pkl"

server {
  devProxy = null
}

database {
  path = "alexandria.e2e.db"
}

// The Google client file is not present in CI; the Dev sign-in is enough.
auth {
  providers {
    [1] { enabled = false }
  }
}

ai {
  enabled = false
}

otel {
  enabled = false
}
