/// Local development. Secrets and real providers go in configs/dev.local.pkl
/// (gitignored), which starts with `amends "dev.pkl"`. Never a real key here.
amends "@schema/AppConfig.pkl"

import "@schema/auth/provider/Dev.pkl"
import "@schema/auth/provider/Oidc.pkl"
import "@schema/ai/provider/OpenAI.pkl"
import "@schema/credential/File.pkl"

logLevel = "debug"

server {
  port = 24380
  publicUrl = "http://localhost:24380"
  devProxy = "http://localhost:24381"
}

database {
  path = "alexandria.dev.db"
}

auth {
  providers {
    new Dev {}
    // Google sign-in. The OAuth client lives in ~/.config/secrets/valsoft.json
    // as {"client_id": "...", "client_secret": "..."}; register
    // http://localhost:24380/api/auth/oidc/google/callback as a redirect URI.
    new Oidc {
      name = "google"
      displayName = "Google"
      issuer = "https://accounts.google.com"
      clientId = new File { path = "~/.config/secrets/valsoft.json"; jsonKey = "client_id" }
      clientSecret = new File { path = "~/.config/secrets/valsoft.json"; jsonKey = "client_secret" }
      extraAuthParams { ["prompt"] = "select_account" }
    }
  }
  admins { "brian@bmurray.ca"; "admin@example.com" }
}

// OpenAI through the Chat Completions API; the key is ~/.openai/auth.json {"key"}.
// Cheap models on purpose. Prices are OpenAI list prices per million tokens,
// 2026-10 (developers.openai.com/api/docs/pricing). e2e.pkl turns this off.
ai {
  enabled = true
  providers {
    new OpenAI {
      name = "openai-luna"
      model = "gpt-6-luna"
      apiKey = new File { path = "~/.openai/auth.json"; jsonKey = "key" }
      inputCostPerMillionUsd = 0.10
      outputCostPerMillionUsd = 0.50
      cacheReadCostPerMillionUsd = 0.01
      reasoningEffort = "none"
      priority = 10
      spendLimitUsd = 5.0
    }
    new OpenAI {
      name = "openai-nano"
      model = "gpt-5-nano"
      apiKey = new File { path = "~/.openai/auth.json"; jsonKey = "key" }
      inputCostPerMillionUsd = 0.05
      outputCostPerMillionUsd = 0.40
      cacheReadCostPerMillionUsd = 0.005
      reasoningEffort = "low"
      priority = 20
    }
  }
  dailySpendLimitUsd = 5.0
}

otel {
  enabled = false
  endpoint = "home-monitoring-otlp.barb-kardashev.ts.net:4317"
  environment = "dev"
}
